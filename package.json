{
  "name": "claude-gdoc-review-plugin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "gdoc-review": "bin/gdoc-review"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "hooks",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "compile": "tsc -b tsconfig.json",
    "bundle": "node esbuild.config.mjs",
    "build": "pnpm run compile && pnpm run bundle",
    "build:dev": "tsc -b tsconfig.json -w",
    "format": "prettier --write \"**/*.{ts,md}\"",
    "format:check": "prettier --check \"**/*.{ts,md}\"",
    "lint": "eslint .",
    "validate": "if command -v claude >/dev/null 2>&1; then claude plugin validate .; else echo 'claude CLI not on PATH; skipping plugin validation'; fi",
    "test": "pnpm run build && NODE_OPTIONS=--experimental-vm-modules jest",
    "test:ci": "pnpm run build && NODE_OPTIONS=--experimental-vm-modules jest --reporters=default --reporters=jest-junit",
    "clean": "rm -rf lib dist *.tsbuildinfo",
    "prepare": "husky"
  },
  "dependencies": {
    "@3fv/prelude-ts": "^0.8.42",
    "lodash": "^4.17.21",
    "source-map-support": "^0.5.21",
    "tracer": "^1.3.0",
    "ts-pattern": "^5.9.0",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "25.5.0",
    "@types/yargs": "^17.0.33",
    "esbuild": "^0.27.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
