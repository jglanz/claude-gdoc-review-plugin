{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/gdoc-review.cjs\" hook",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^mcp__.+__(update_drive_file|manage_document_comment)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/gdoc-review.cjs\" hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/gdoc-review.cjs\" hook",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^mcp__.+__(update_drive_file|import_to_google_doc|manage_document_comment)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/gdoc-review.cjs\" hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/gdoc-review.cjs\" hook",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/gdoc-review.cjs\" hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
